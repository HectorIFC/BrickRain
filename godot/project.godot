; Engine configuration file.
; Godot project for the BrickRain web implementation.
; The Roku channel at the repository root is a separate, independent build.

config_version=5

[application]

config/name="BrickRain"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/images/icon.png"

; Without these the engine shows the Godot logo while it loads, which is the
; first thing an Instant Games player sees. bg_color matches the in-game
; background (#080A22) so there is no colour flash between splash and game.
boot_splash/bg_color=Color(0.031373, 0.039216, 0.133333, 1)
boot_splash/image="res://assets/images/boot_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[audio]

; Godot 4.4+ defaults the web platform to "Sample" playback, handing streams
; straight to Web Audio instead of mixing them. Streams it cannot sample -
; looping Ogg, and anything built at runtime with load_from_buffer - are then
; dropped with only a warning, so the game reports playing=true, the mixer runs
; at full rate, and every sample is silence. Forcing Stream playback routes
; audio through Godot's mixer, which is what actually reaches the speakers.
general/default_playback_type.web=0

[autoload]

; FBBridge must come first: Ads connects to its signals in _ready.
FBBridge="*res://platform/fb_bridge.gd"
Ads="*res://platform/ads.gd"
Music="*res://platform/music.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; The colour behind everything the game draws. Deliberately identical to
; boot_splash/bg_color and GameTheme.background_color(): during the first
; frames the canvas is already up while the splash still shows, and any
; difference between the two reads as dark bands around the splash.
environment/defaults/default_clear_color=Color(0.031373, 0.039216, 0.133333, 1)
