# --- Dependencies ---
node_modules/

# --- Build output ---
out/
dist/
build/
.roku-deploy-staging/
staging/

# --- Secrets & Roku signing (never commit) ---
.env
.env.local
*.pkg
*.key
*.pem
*.txt

# --- Test & coverage output ---
coverage/
.nyc_output/

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors & IDEs ---
.idea/
*.iml
*.swp
*.swo
*~

# --- Python (asset generator tools) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Godot (web implementation) ---
# The web export writes to build/ (already ignored above) rather than inside
# godot/, so the previous export's assets can never be re-imported into the
# project and packed into the next build.
godot/.godot/
godot/android/
