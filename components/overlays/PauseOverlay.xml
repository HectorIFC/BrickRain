<?xml version="1.0" encoding="utf-8" ?>
<!--
  Pause menu shown over the frozen game. The native ButtonGroup handles focus and
  navigation; this component maps the chosen button to a `selection` string that
  GameScreen observes (resume / restart / quit).
-->
<component name="PauseOverlay" extends="Group">
    <interface>
        <field id="selection" type="string" value="" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x080A22E6" />
        <Label text="PAUSED" font="font:LargeBoldSystemFont" color="0x00F0F0FF" horizAlign="center" width="1920" translation="[0, 360]" />
        <ButtonGroup id="menu" translation="[820, 480]" minWidth="280" />
    </children>
</component>
